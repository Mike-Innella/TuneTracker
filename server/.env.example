# Local development template. Copy to .env.local (not committed).
DATABASE_URL="mysql://appuser:apppassword@127.0.0.1:3306/tunetracker"
MIGRATE_DATABASE_URL="mysql://root:rootpassword@127.0.0.1:3306/tunetracker"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
SESSION_COOKIE_SECURE=false
STORAGE_DRIVER="local"
UPLOADS_DIR=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""
AWS_S3_PUBLIC_BASE_URL=""
AWS_S3_KEY_PREFIX=""
AWS_S3_SIGNED_URL_TTL_SECONDS=300
AWS_S3_FORCE_PATH_STYLE=false
# Optional: enable DB integration tests
# RUN_DB_TESTS=1
