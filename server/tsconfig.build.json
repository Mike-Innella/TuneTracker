{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "out",
    ".next",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.js.map",
    "src/**/*.d.ts.map"
  ]
}
