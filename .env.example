# Copy to .env (gitignored). Local values come from: npm run supabase:start
# then: npx supabase status --workdir data

# --- Postgres (Prisma) ---
# App connection. On Vercel use Supabase's transaction pooler URL (port 6543).
DATABASE_URL=postgresql://tunetracker:tunetracker@127.0.0.1:5432/tunetracker
# Direct (non-pooled) connection used only by migrations.
DIRECT_URL=postgresql://tunetracker:tunetracker@127.0.0.1:5432/tunetracker
# Max connections per serverless instance (default 3).
# DB_POOL_MAX=3

# --- Supabase (Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose to the browser. Used to sign uploads and verify storage objects.
SUPABASE_SERVICE_ROLE_KEY=
# Only when the server reaches Supabase on a different host than the browser (Docker).
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Multiplies rate limits (>=1, never disables them). Raise only for local e2e runs.
# RATE_LIMIT_SCALE=1
