// TuneTracker 2.0 — Prisma owns every table in the `public` schema.
// Supabase migrations (data/supabase/migrations) own only `storage` buckets/policies.
// Profile.id equals auth.users.id; there is deliberately no cross-schema FK so the
// schema also migrates on plain Postgres (Docker dev DB, CI).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum MemberRole {
  EDITOR
  VIEWER
}

enum ProfileRole {
  USER
  MODERATOR
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum ModerationOutcome {
  DISMISSED
  CONTENT_REMOVED
  USER_SUSPENDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PostType {
  PROGRESS
  FINISHED
  SAMPLE
  FEEDBACK
}

enum ReactionType {
  LIKE
  FIRE
  HEART
  MIND_BLOWN
}

enum MediaKind {
  AUDIO
  IMAGE
  FILE
}

enum ReportTarget {
  POST
  COMMENT
  PROFILE
}

model Profile {
  id          String      @id @db.Uuid
  username    String      @unique
  displayName String
  bio         String?
  avatarPath  String?
  location    String?
  website     String?
  specialties String[]
  isPublic    Boolean     @default(true)
  theme       String      @default("dark")
  /// server-only: matches email invitations to accounts; never selected into public payloads
  email       String?     @unique
  role        ProfileRole @default(USER)
  suspendedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  socialLinks       SocialLink[]
  followers         Follow[]           @relation("FollowFollowing")
  following         Follow[]           @relation("FollowFollower")
  invitesSent       ProjectInvite[]    @relation("InviteInviter")
  invitesReceived   ProjectInvite[]    @relation("InviteInvitee")
  moderationActions ModerationAction[]
  ownedProjects     Project[]          @relation("ProjectOwner")
  memberships       ProjectMember[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  taskComments      TaskComment[]
  posts             Post[]
  postComments      PostComment[]
  reactions         Reaction[]
  media             MediaAsset[]
  notifications     Notification[]     @relation("NotificationRecipient")
  activity          Activity[]
  reports           Report[]
}

model SocialLink {
  id        String  @id @default(cuid())
  profileId String  @db.Uuid
  label     String
  url       String
  position  Int     @default(0)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String            @id @default(cuid())
  ownerId     String            @db.Uuid
  title       String
  description String?
  artworkPath String?
  visibility  ProjectVisibility @default(PRIVATE)
  status      ProjectStatus     @default(ACTIVE)
  template    String?
  dueDate     DateTime?
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner    Profile         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  ProjectMember[]
  columns  BoardColumn[]
  tasks    Task[]
  labels   Label[]
  posts    Post[]
  media    MediaAsset[]
  activity Activity[]
  invites  ProjectInvite[]

  @@index([ownerId, archivedAt])
  @@index([visibility])
}

model ProjectMember {
  projectId String
  profileId String     @db.Uuid
  role      MemberRole @default(VIEWER)
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([projectId, profileId])
  @@index([profileId])
}

// One board per project: columns hang directly off the project.
model BoardColumn {
  id        String   @id @default(cuid())
  projectId String
  title     String
  position  Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  columnId    String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  position    Int
  dueDate     DateTime?
  assigneeId  String?      @db.Uuid
  bpm         Int?
  musicalKey  String?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column      BoardColumn     @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee    Profile?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels      Label[]
  checklist   ChecklistItem[]
  comments    TaskComment[]
  attachments MediaAsset[]

  @@index([columnId, position])
  @@index([projectId])
  @@index([assigneeId, dueDate])
}

model Label {
  id        String  @id @default(cuid())
  projectId String
  name      String
  color     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
}

model ChecklistItem {
  id       String  @id @default(cuid())
  taskId   String
  text     String
  done     Boolean @default(false)
  position Int
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// Every uploaded object in Supabase Storage. bucket+path is the storage key.
model MediaAsset {
  id          String    @id @default(cuid())
  ownerId     String    @db.Uuid
  projectId   String?
  taskId      String?
  kind        MediaKind
  bucket      String
  path        String
  mimeType    String
  sizeBytes   Int
  durationSec Float?
  title       String?
  // null until the server has verified the object exists in storage
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  owner      Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  audioPosts Post[]   @relation("PostAudio")
  imagePosts Post[]   @relation("PostImage")

  @@unique([bucket, path])
  @@index([ownerId])
  @@index([taskId])
}

model Post {
  id                String   @id @default(cuid())
  authorId          String   @db.Uuid
  projectId         String?
  type              PostType @default(PROGRESS)
  title             String
  body              String
  genre             String?
  tags              String[]
  links             String[]
  feedbackRequested Boolean  @default(false)
  audioId           String?
  imageId           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  author    Profile       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  audio     MediaAsset?   @relation("PostAudio", fields: [audioId], references: [id], onDelete: SetNull)
  image     MediaAsset?   @relation("PostImage", fields: [imageId], references: [id], onDelete: SetNull)
  comments  PostComment[]
  reactions Reaction[]

  @@index([createdAt(sort: Desc), id])
  @@index([authorId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Reaction {
  postId    String
  profileId String       @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([postId, profileId, type])
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String    @db.Uuid
  type        String
  message     String
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   Profile   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  actorId   String   @db.Uuid
  summary   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     Profile  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Report {
  id         String             @id @default(cuid())
  reporterId String             @db.Uuid
  targetType ReportTarget
  targetId   String
  reason     String
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?
  outcome    ModerationOutcome?
  reporter   Profile            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  actions    ModerationAction[]

  @@unique([reporterId, targetType, targetId])
}

// Fixed-window rate limiting shared by every serverless instance.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())
  follower    Profile  @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   Profile  @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

/// A pending invitation to collaborate on a project. Registered invitees are linked by id;
/// people without an account are invited by email and linked when they first sign in.
model ProjectInvite {
  id          String       @id @default(cuid())
  projectId   String
  inviterId   String       @db.Uuid
  inviteeId   String?      @db.Uuid
  email       String?
  role        MemberRole   @default(VIEWER)
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter     Profile      @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     Profile?     @relation("InviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([email, status])
  @@index([projectId, status])
}

/// Audit trail: every moderator decision, kept even after the content is gone.
model ModerationAction {
  id          String            @id @default(cuid())
  moderatorId String?           @db.Uuid
  reportId    String?
  outcome     ModerationOutcome
  targetType  ReportTarget
  targetId    String
  note        String?
  createdAt   DateTime          @default(now())
  moderator   Profile?          @relation(fields: [moderatorId], references: [id], onDelete: SetNull)
  report      Report?           @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
