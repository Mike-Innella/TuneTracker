DOCKERHUB_USERNAME=your-dockerhub-user
APP_IMAGE_TAG=latest

JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=https://app.example.com

DATABASE_URL=mysql://appuser:apppassword@your-rds-endpoint:3306/tunetracker
MIGRATE_DATABASE_URL=mysql://appuser:apppassword@your-rds-endpoint:3306/tunetracker

SESSION_COOKIE_SECURE=true
STORAGE_DRIVER=s3
UPLOADS_DIR=/app/uploads

AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_KEY_PREFIX=tracks
AWS_S3_SIGNED_URL_TTL_SECONDS=300
AWS_S3_FORCE_PATH_STYLE=false
